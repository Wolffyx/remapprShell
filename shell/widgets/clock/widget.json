{
    "id": "clock",
    "apiVersion": 1,
    "name": "Clock",
    "description": "Current time and date.",
    "icon": "clock",
    "zones": [
        "left",
        "middle",
        "right"
    ],
    "orientation": [
        "horizontal",
        "vertical"
    ],
    "renderers": {
        "quickshell": {
            "entry": "Widget.qml"
        },
        "plasma": {
            "applet": "org.kde.plasma.digitalclock"
        }
    },
    "config": {
        "hour12": {
            "type": "bool",
            "default": false,
            "label": "12-hour clock"
        },
        "showSeconds": {
            "type": "bool",
            "default": false,
            "label": "Show seconds"
        },
        "showDate": {
            "type": "bool",
            "default": true,
            "label": "Show date",
            "description": "Under the time; beside it on a thin panel, and not at all down the side of the screen."
        },
        "format": {
            "type": "string",
            "default": "",
            "label": "Time format of your own",
            "description": "A Qt date/time format string, which wins over the choices above. Empty for those."
        },
        "dateFormat": {
            "type": "string",
            "default": "ddd d MMM",
            "label": "Date format"
        }
    }
}
