{
    "id": "tasks",
    "apiVersion": 1,
    "name": "Open windows",
    "description": "The windows you have open, and a click to switch to one. Needs the window list turned on: rmpr windows enable.",
    "icon": "preferences-system-windows",
    "zones": [
        "left",
        "middle",
        "right"
    ],
    "orientation": [
        "horizontal"
    ],
    "renderers": {
        "quickshell": {
            "entry": "Widget.qml"
        },
        "plasma": {
            "applet": "org.kde.plasma.icontasks"
        }
    },
    "config": {
        "showTitles": {
            "type": "bool",
            "default": false,
            "label": "Show titles",
            "description": "Off by default: a panel runs out of room after four or five titles, and the title is one hover away."
        },
        "maxWidth": {
            "type": "int",
            "default": 180,
            "min": 60,
            "max": 400,
            "label": "Widest a button gets",
            "description": "Titles are elided past this."
        },
        "iconSize": {
            "type": "int",
            "default": 18,
            "min": 12,
            "max": 48,
            "label": "Icon size"
        }
    }
}
