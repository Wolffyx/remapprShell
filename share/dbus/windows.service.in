# GENERATED FILE -- DO NOT EDIT. Regenerate: make link
#
# Starts the window-list daemon on demand, the first time anything calls it --
# the KWin script pushing an update, or the shell asking for the list. Nothing
# runs until something needs it, and nothing has to be enabled or remembered.
[D-BUS Service]
Name=@DBUS_NAME@
#
# Through sh, which is what expands $HOME: a service file expands nothing, and
# the daemon's path is rendered under the home directory rather than as this
# machine's. exec, so the daemon is the process the bus started.
Exec=/bin/sh -c 'exec "@BIN_DIR@/@WINDOWSD_BIN@"'
