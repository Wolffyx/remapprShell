# GENERATED FILE -- DO NOT EDIT. Regenerate: make link
#
# Runs when the shell's unit fails. A shell cannot report its own death, so the
# capture lives out here in a separate unit and a plain shell script: by the
# time this runs, there is no QML left to ask.
[Unit]
Description=@DISPLAY_NAME@ diagnostic report for %i

[Service]
Type=oneshot
ExecStart=-@BIN_DIR@/@CTL_BIN@ report create --reason "%i failed"

# Then, once systemd has stopped restarting the shell, a window that says so.
# Nothing serves notifications while the shell is down -- it is the server --
# so this is the one way left to tell anyone (2026-10-08). The report's "-":
# a report that could not be written is no reason not to say the shell is
# down. Run at every failure, it opens nothing while a restart is still to
# come; see scripts/rescue.sh.
ExecStart=@BIN_DIR@/@CTL_BIN@ rescue --if-given-up

# The report is written locally and nothing is sent anywhere, so a failure here
# is worth a journal line and nothing more.
StandardOutput=journal
StandardError=journal
