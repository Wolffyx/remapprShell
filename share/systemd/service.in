# GENERATED FILE -- DO NOT EDIT. Regenerate: make link
[Unit]
Description=@DISPLAY_NAME@
Documentation=@REPO_FETCH@
PartOf=graphical-session.target

# Started with Plasma's core -- KWin, ksmserver, plasmashell -- and not after
# graphical-session.target, which Plasma reaches only once the whole workspace
# is up. powerdevil alone held that back by six seconds at login, while
# plasmashell's own panel was already on screen. What starts later is watched
# for, not waited for: every DbusWatch re-reads when its service appears.
After=plasma-core.target

# The shell is a Wayland client and cannot start without a compositor.
Requisite=plasma-core.target

# A shell that dies cannot write its own report, so the capture is a separate
# unit that systemd starts precisely when this one fails. Note that quickshell
# catches its own crashes and restarts in process, so this fires for a failure
# to start rather than for a crash -- `rmpr crash list` is where those are.
OnFailure=@SLUG@-report@%n.service

# A shell that cannot start at all must stop trying, rather than spinning and
# filling the journal. These belong in [Unit]: systemd ignores them in
# [Service], where they were, with "Unknown key 'StartLimitIntervalSec'" in the
# journal and no limit actually applied.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=@BIN_DIR@/@SESSION_BIN@

# A crash should not leave the user with no panel. RestartSec is short because
# the failure that matters -- a widget bringing the shell down at boot -- is
# detected by the shell's own quarantine, not by giving up here.
Restart=on-failure
RestartSec=2s

Slice=session.slice
TimeoutStopSec=5s

[Install]
WantedBy=plasma-core.target
