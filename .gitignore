# Generated - never committed
shell/core/Branding.qml
theme/lockscreen/Options.qml

# The pattern-check hooks' own logs: a record of local tool decisions, not of
# the project. Committed once by accident on 2026-09-14.
.claude/pattern-decision-log.jsonl
.claude/pattern-block-stats.jsonl

# Build / scratch
# The preview harness copies the whole shell per run and removes it on exit;
# a run killed before its trap leaves one behind. switcher.sh does the same
# with a directory of its own -- a directory, so the pattern cannot hide a
# file named switcher.anything.
dev/preview/root.*
dev/preview/switcher.*/
/build/
# `make plugin` builds here; the installed module lives in the user's Qt
# import path and is removed by `make plugin-clean`.
/dist/
*.qmlc
*.jsc
.qmlls.ini

# Editor
.idea/
.vscode/
*.swp
*~
shell/**/qmldir
shell/widgets/index.json
theme/colors/*.colors
