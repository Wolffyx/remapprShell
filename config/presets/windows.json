{
    "name": "Windows-like",
    "description": "Windows-style: start button, the windows you have open, then the tray, the clock and a show-desktop strip at the far end.",
    "config": {
        "panel": {
            "position": "bottom",
            "thickness": 40
        },
        "bar": {
            "entries": [
                {
                    "id": "launcher",
                    "zone": "left",
                    "enabled": true
                },
                {
                    "id": "tasks",
                    "zone": "left",
                    "enabled": true
                },
                {
                    "id": "media",
                    "zone": "right",
                    "enabled": true
                },
                {
                    "id": "tray",
                    "zone": "right",
                    "enabled": true
                },
                {
                    "id": "bluetooth",
                    "zone": "right",
                    "enabled": true
                },
                {
                    "id": "network",
                    "zone": "right",
                    "enabled": true
                },
                {
                    "id": "volume",
                    "zone": "right",
                    "enabled": true
                },
                {
                    "id": "battery",
                    "zone": "right",
                    "enabled": true
                },
                {
                    "id": "clock",
                    "zone": "right",
                    "enabled": true
                },
                {
                    "id": "showdesktop",
                    "zone": "right",
                    "enabled": true
                }
            ]
        },
        "widgets": {
            "clock": {
                "format": "HH:mm",
                "showDate": true,
                "dateFormat": "ddd d MMM"
            },
            "launcher": {
                "icon": "start-here-kde"
            }
        }
    }
}
