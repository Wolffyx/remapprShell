{
    "name": "Windows-like",
    "description": "Windows-style: start button, the windows you have open, then the tray, the quick settings as one button, the clock and a show-desktop strip at the far end.",
    "config": {
        "panel": {
            "position": "bottom",
            "thickness": 40
        },
        "bar": {
            "entries": [
                {
                    "id": "launcher",
                    "zone": "left",
                    "enabled": true
                },
                {
                    "id": "tasks",
                    "zone": "left",
                    "enabled": true
                },
                {
                    "id": "media",
                    "zone": "right",
                    "enabled": true
                },
                {
                    "id": "clipboard",
                    "zone": "right",
                    "enabled": true
                },
                {
                    "id": "tray",
                    "zone": "right",
                    "enabled": true
                },
                {
                    "id": "privacy",
                    "zone": "right",
                    "enabled": true
                },
                {
                    "id": "keyboard",
                    "zone": "right",
                    "enabled": true
                },
                {
                    "id": "status",
                    "zone": "right",
                    "enabled": true
                },
                {
                    "id": "clock",
                    "zone": "right",
                    "enabled": true
                },
                {
                    "id": "showdesktop",
                    "zone": "right",
                    "enabled": true
                }
            ]
        },
        "widgets": {
            "clock": {
                "hour12": false,
                "showSeconds": false,
                "showDate": true,
                "dateFormat": "ddd d MMM"
            },
            "launcher": {
                "icon": "start-here-kde"
            },
            "status": {
                "parts": [
                    "bluetooth",
                    "network",
                    "brightness",
                    "volume",
                    "battery"
                ],
                "capsule": true
            }
        }
    }
}
