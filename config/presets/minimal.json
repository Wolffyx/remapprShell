{
    "name": "Minimal",
    "description": "A thin bar with the time and the system tray, volume and network included. Nothing else.",
    "config": {
        "panel": { "position": "top", "thickness": 28 },
        "bar": {
            "entries": [
                { "id": "clock",   "zone": "middle", "enabled": true },
                { "id": "tray",     "zone": "right",  "enabled": true },
                { "id": "privacy",  "zone": "right",  "enabled": true },
                { "id": "keyboard", "zone": "right",  "enabled": true },
                { "id": "network",  "zone": "right",  "enabled": true },
                { "id": "volume",  "zone": "right",  "enabled": true },
                { "id": "battery", "zone": "right",  "enabled": true }
            ]
        },
        "widgets": { "clock": { "hour12": false, "showSeconds": false } }
    }
}
