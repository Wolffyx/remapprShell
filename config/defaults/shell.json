{
    "schemaVersion": 1,
    "theme": {
        "mode": "auto",
        "accent": "plasma",
        "translucent": true,
        "shadows": false,
        "rounding": 8,
        "animationMs": 180,
        "desktop": {
            "enabled": true,
            "followMode": false,
            "rescuePlasmaSwitch": true,
            "gtkThemeLight": "",
            "gtkThemeDark": "",
            "materialYou": false,
            "colours": true,
            "gtk": true,
            "icons": true,
            "style": true,
            "plasmaTheme": true,
            "decorations": true,
            "switcher": true
        }
    },
    "panel": {
        "renderer": "quickshell",
        "position": "bottom",
