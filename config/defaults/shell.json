    "launcher": {
        "provider": "builtin",
        "searchProvider": "builtin",
        "kickoffMode": "menu",
        "command": [],
        "layout": "twopane",
        "actionPrefix": ">",
        "dense": false,
        "hints": true,
        "searchSources": [
            "apps",
            "windows",
            "files",
            "settings"
        ],
        "learn": true,
        "pinned": []
    },
    "audio": {
        "raiseMaxVolume": false
    },
    "osd": {
        "enabled": false,
        "timeout": 1800
    },
    "notifications": {
        "history": true,
        "historySize": 50,
        "server": "shell",
        "popupTimeout": 6,
        "popupPosition": "auto",
        "centreStyle": "grouped"
    },
    "services": {
        "hostPlasma": true
    },
    "ai": {
        "enabled": false,
        "provider": "clipboard",
        "command": [],
        "ollamaUrl": "http://127.0.0.1:11434",
        "ollamaModel": ""
    },
    "session": {
        "prompt": "plasma"
    },
    "switching": {
        "windows": "plasma",
        "desktops": "plasma",
        "overviewHold": true,
        "overviewTitles": true,
        "overviewMinimised": true,
        "overviewStrip": true,
        "overviewCardWidth": 560
    },
    "snapshots": {
        "keep": 0
    },
    "widgets": {
        "clock": {
            "format": "",
            "showDate": true,
            "dateFormat": "ddd d MMM",
            "hour12": false,
            "showSeconds": false
        },
        "launcher": {
            "icon": "start-here-kde"
        },
        "tray": {
            "iconSize": 22
        },
        "workspaces": {
            "style": "icons"
        },
        "tasks": {
            "showTitles": false
        }
    },
    "desktop": {
        "border": false,
        "clock": true,
        "borderInset": 0,
        "borderRadius": 13,
        "clockPosition": "bottom-right",
        "clockSize": 92,
        "clockDate": true,
        "clockInk": "auto"
    },
    "sidebar": {
        "position": "right",
        "trigger": "drag",
        "handleWidth": 6,
        "width": 396,
        "margin": 16,
        "reserveSpace": false,
