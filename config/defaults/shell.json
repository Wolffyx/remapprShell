        "style": "full",
        "spacing": 5,
        "iconSize": 18,
        "autoHide": false,
        "revealOnHover": true,
        "menu": {
            "systemMonitor": "auto",
            "entries": []
        }
    },
    "bar": {
        "entries": [
            {
                "id": "launcher",
                "zone": "left",
                "enabled": true
