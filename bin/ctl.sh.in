#!/usr/bin/env bash
# @DISPLAY_NAME@ control.
# GENERATED FILE -- DO NOT EDIT. Regenerate: make link  (or scripts/install.sh)
set -euo pipefail

REPO_ROOT="@REPO_ROOT@"

usage() {
    cat <<USAGE
@DISPLAY_NAME@ @VERSION@

usage: @ALIAS@ <command> [options]

  setup [--unattended|--dry-run]    the guided install: ask, then apply
  preflight [--suggest-snapshots]   check this machine, report what may change
  snapshot create|list|remove|prune  manage restore points
  restore [--preinstall|--list]     put KDE back the way it was
  renderer status|list|set|revert   choose what draws the panel
  theme apply|revert|variant|osd|style|status  the look and feel, light or dark, which OSD draws
  report create|list|show|remove    write a local diagnostic report
  ask [--last-notification|--crash] hand a redacted report to an assistant (opt-in)
  crash list|show|remove            crashes quickshell caught and systemd did not
  windows enable|disable|status     the open-window list (needs a KWin script)
  edges status|set|snap|disable-all the screen's corners and edges (KWin's)
  switcher status|layout|give|show  Alt+Tab's look, who holds the keys, and ours on screen
  lockscreen status|check|try|enable|disable|set  our lock screen (opt-in; try it first)
  shortcuts status|set|clear        global shortcuts for this shell's own actions
  settings [page|pages]             open the settings window on a page; list the pages
  clipboard                         open the clipboard history (bind: shortcuts set clipboard)
  sidebar                           open or close the sidebar (bind: shortcuts set sidebar)
  keys                              open or close the key sheet (bind: shortcuts set keys)
  session [kind]                    the session screen: log out, restart, sleep, shut down
  wizard                            re-run the first-run wizard
  status                            is the shell installed and running?
  doctor                            check everything and report fixes
  update [--check|--rollback]       update the shell
  ipc <target> <call> [args]        call the running shell directly
  log [-f]                          show the shell's journal
  start | stop | restart            control the user service
  reload                            reload the running shell's QML (after editing a widget)
  version                           print the version

Anything not listed here is not implemented yet.
USAGE
}

# Is this path one of our own source trees? `<tree>/shell/shell.qml` with a
# branding.json naming this slug two directories up. Asked of a path rather
# than assumed from where it lives, because a checkout is wherever the person
# working on it put it -- a git worktree beside the repository, most often.
_is_our_checkout() {
    local qml=$1 tree
    case "$qml" in */shell/shell.qml) ;; *) return 1 ;; esac
    tree=${qml%/shell/shell.qml}
    [ -f "$tree/branding.json" ] || return 1
    grep -q "\"slug\"[[:space:]]*:[[:space:]]*\"@SLUG@\"" "$tree/branding.json" 2>/dev/null
}

# The IPC socket is keyed by the config path the shell was started with, so a
# command has to name the copy that is actually running. `make run` from a
# checkout names the source tree, and every one of these calls asked for the
# installed path -- so `@ALIAS@ settings` answered "No running instances" with
# the settings window's own shell on screen.
#
# Three answers, in order. The installed copy wins when more than one is up:
# it is the one a person who did not build anything is using. Then this
# checkout. Then any other checkout of this project that is running, which is
# the case the first version missed -- the shell was being run from a second
# worktree, so it matched neither of the two paths the script knew and went on
# failing after the fix. Another shell's Quickshell config is not a candidate:
# the layout and the branding both have to be ours.
shell_ipc_path() {
    local procs installed line qml
    installed="@QS_CONFIG_DIR@/shell.qml"
    procs=$(pgrep -a -x quickshell 2>/dev/null) || true

    case "$procs" in
        *"$installed"*)                  printf '%s' "$installed"; return ;;
        *"@REPO_ROOT@/shell/shell.qml"*) printf '%s' "@REPO_ROOT@/shell/shell.qml"; return ;;
    esac

    while IFS= read -r line; do
        # "<pid> <argv...>": the config path follows -p, and nothing else in
        # the command line ends in shell.qml.
        for qml in $line; do
            case "$qml" in
                *shell.qml) _is_our_checkout "$qml" && { printf '%s' "$qml"; return; } ;;
            esac
        done
    done <<< "$procs"

    printf '%s' "$installed"
}

require_repo() {
    [ -d "$REPO_ROOT/scripts" ] || {
        echo "error: the source tree is missing at $REPO_ROOT" >&2
        echo "       reinstall, or run the scripts from a checkout" >&2
        exit 1
    }
}

cmd=${1:-help}
[ $# -gt 0 ] && shift

case "$cmd" in
    setup)     require_repo; exec "$REPO_ROOT/scripts/setup.sh" "$@" ;;
    preflight) require_repo; exec "$REPO_ROOT/scripts/preflight.sh" "$@" ;;
    restore)   require_repo; exec "$REPO_ROOT/scripts/restore.sh" "$@" ;;
    theme)     require_repo; exec "$REPO_ROOT/scripts/theme.sh" "$@" ;;
    renderer)  require_repo; exec "$REPO_ROOT/scripts/renderer.sh" "$@" ;;
    report)    require_repo; exec "$REPO_ROOT/scripts/report.sh" "$@" ;;
    ask)       require_repo; exec "$REPO_ROOT/scripts/ask.sh" "$@" ;;
    crash)     require_repo; exec "$REPO_ROOT/scripts/crash.sh" "$@" ;;
    windows)   require_repo; exec "$REPO_ROOT/scripts/windows.sh" "$@" ;;
    doctor)    require_repo; exec "$REPO_ROOT/scripts/doctor.sh" "$@" ;;
    preset)    require_repo; exec "$REPO_ROOT/scripts/preset.sh" "$@" ;;
    update)    require_repo; exec "$REPO_ROOT/scripts/update.sh" "$@" ;;
    profile)   require_repo; exec "$REPO_ROOT/scripts/profile.sh" "$@" ;;
    edges)     require_repo; exec "$REPO_ROOT/scripts/edges.sh" "$@" ;;
    switcher)  require_repo; exec "$REPO_ROOT/scripts/switcher.sh" "$@" ;;
    lockscreen) require_repo; exec "$REPO_ROOT/scripts/lockscreen.sh" "$@" ;;
    shortcuts) require_repo; exec "$REPO_ROOT/scripts/shortcuts.sh" "$@" ;;

    # Both talk to the running shell rather than reimplementing the choice, so
    # a keybinding and the panel button always open the same thing.
    launcher)
        exec quickshell ipc --path "$(shell_ipc_path)" call launcher toggle
        ;;

    # The clipboard widget's popout. Meta+V is Klipper's, and under our own
    # renderer Klipper is not running, so this is what to bind it to instead.
    clipboard)
        exec quickshell ipc --path "$(shell_ipc_path)" call clipboard toggle
        ;;

    # The sidebar and the key sheet: each opens on the first screen, and a
    # second press closes it.
    sidebar|keys)
        exec quickshell ipc --path "$(shell_ipc_path)" call surfaces "$cmd"
        ;;

    # The session screen: log out, restart, sleep, shut down. The kind picks
    # which button starts under the keys, as Plasma's own prompt names them,
    # and it is always passed: the IPC declares the argument, so leaving it out
    # is refused ("1 required but 0 were provided") rather than defaulted.
    session)
        case "${1:-promptAll}" in
            promptAll|promptLogout|promptReboot|promptShutDown) ;;
            *) echo "unknown session kind: $1" >&2
               echo "       one of: promptAll promptLogout promptReboot promptShutDown" >&2
               exit 1 ;;
        esac
        exec quickshell ipc --path "$(shell_ipc_path)" call surfaces session "${1:-promptAll}"
        ;;

    settings)
        # `settings <page>` opens straight to one, by its schema section id,
        # and `settings pages` lists the ids -- which is the only way to learn
        # them from the CLI, so no schema section may be called `pages`.
        case "${1:-}" in
            "")     exec quickshell ipc --path "$(shell_ipc_path)" call settings toggle ;;
            pages)  exec quickshell ipc --path "$(shell_ipc_path)" call settings pages ;;
            *)      exec quickshell ipc --path "$(shell_ipc_path)" call settings page "$1" ;;
        esac
        ;;

    wizard)
        exec quickshell ipc --path "$(shell_ipc_path)" call wizard open
        ;;

    # Quickshell notices edits only to files the config imported at load; a
    # widget's own files are loaded later and are not watched.
    reload)
        exec quickshell ipc --path "$(shell_ipc_path)" call shell reload
        ;;

    search)
        if [ $# -gt 0 ]; then
            exec quickshell ipc --path "$(shell_ipc_path)" call launcher query "$*"
        fi
        exec quickshell ipc --path "$(shell_ipc_path)" call launcher search
        ;;

    snapshot)  require_repo; exec "$REPO_ROOT/scripts/snapshot.sh" "$@" ;;

    status)
        printf 'installed:  '
        [ -e "@QS_CONFIG_DIR@" ] && echo "yes (@QS_CONFIG_DIR@)" || echo "no"
        printf 'running:    '
        # Either copy counts: the installed one, or `make run` from a
        # checkout, whose command line names the source tree instead. Saying
        # "no" to a shell that is plainly on screen is how an afternoon goes
        # missing.
        if pgrep -a -x quickshell 2>/dev/null | grep -qF "@QS_CONFIG_DIR@"; then
            echo "yes"
        elif pgrep -a -x quickshell 2>/dev/null | grep -qF "@REPO_ROOT@/shell/shell.qml"; then
            echo "yes (from the working tree at @REPO_ROOT@)"
        else
            echo "no"
        fi
        printf 'service:    '
        systemctl --user is-active "@SYSTEMD_UNIT@" 2>/dev/null || true
        printf 'config:     %s\n' "@CONFIG_DIR@"
        printf 'state:      %s\n' "@STATE_DIR@"
        ;;

    # Straight through to the running shell, with the path worked out here.
    #
    # Which copy is running decides that path -- the installed one under
    # ~/.config/quickshell, or this worktree under `make run` -- and every
    # example that wrote one of them out was wrong for whoever was running the
    # other. `@ALIAS@ ipc panel layout DP-2` is right either way.
    ipc)
        [ $# -ge 2 ] || { echo "usage: @ALIAS@ ipc <target> <call> [args...]" >&2; exit 1; }
        exec quickshell ipc --path "$(shell_ipc_path)" call "$@"
        ;;

    log)     exec journalctl --user -u "@SYSTEMD_UNIT@" "$@" ;;
    start)   exec systemctl --user start "@SYSTEMD_UNIT@" ;;
    stop)    exec systemctl --user stop "@SYSTEMD_UNIT@" ;;
    restart) exec systemctl --user restart "@SYSTEMD_UNIT@" ;;

    version) echo "@DISPLAY_NAME@ @VERSION@" ;;
    help|-h|--help) usage ;;
    *) echo "unknown command: $cmd" >&2; echo >&2; usage >&2; exit 1 ;;
esac
