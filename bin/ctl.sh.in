#!/usr/bin/env bash
# @DISPLAY_NAME@ control.
# GENERATED FILE -- DO NOT EDIT. Regenerate: make link  (or scripts/install.sh)
set -euo pipefail

REPO_ROOT="@REPO_ROOT@"

usage() {
    cat <<USAGE
@DISPLAY_NAME@ @VERSION@

usage: @ALIAS@ <command> [options]

  preflight [--suggest-snapshots]   check this machine, report what may change
  snapshot create|list|remove|prune  manage restore points
  restore [--preinstall|--list]     put KDE back the way it was
  renderer status|list|set|revert   choose what draws the panel
  theme apply|revert|osd|status     the look and feel, and which OSD draws
  report create|list|show|remove    write a local diagnostic report
  wizard                            re-run the first-run wizard
  status                            is the shell installed and running?
  doctor                            check everything and report fixes
  update [--check|--rollback]       update the shell
  log [-f]                          show the shell's journal
  start | stop | restart            control the user service
  version                           print the version

Anything not listed here is not implemented yet.
USAGE
}

require_repo() {
    [ -d "$REPO_ROOT/scripts" ] || {
        echo "error: the source tree is missing at $REPO_ROOT" >&2
        echo "       reinstall, or run the scripts from a checkout" >&2
        exit 1
    }
}

cmd=${1:-help}
[ $# -gt 0 ] && shift

case "$cmd" in
    preflight) require_repo; exec "$REPO_ROOT/scripts/preflight.sh" "$@" ;;
    restore)   require_repo; exec "$REPO_ROOT/scripts/restore.sh" "$@" ;;
    theme)     require_repo; exec "$REPO_ROOT/scripts/theme.sh" "$@" ;;
    renderer)  require_repo; exec "$REPO_ROOT/scripts/renderer.sh" "$@" ;;
    report)    require_repo; exec "$REPO_ROOT/scripts/report.sh" "$@" ;;
    doctor)    require_repo; exec "$REPO_ROOT/scripts/doctor.sh" "$@" ;;
    preset)    require_repo; exec "$REPO_ROOT/scripts/preset.sh" "$@" ;;
    update)    require_repo; exec "$REPO_ROOT/scripts/update.sh" "$@" ;;
    profile)   require_repo; exec "$REPO_ROOT/scripts/profile.sh" "$@" ;;
    edges)     require_repo; exec "$REPO_ROOT/scripts/edges.sh" "$@" ;;
    shortcuts) require_repo; exec "$REPO_ROOT/scripts/shortcuts.sh" "$@" ;;

    # Both talk to the running shell rather than reimplementing the choice, so
    # a keybinding and the panel button always open the same thing.
    launcher)
        exec quickshell ipc --path "@QS_CONFIG_DIR@/shell.qml" call launcher toggle
        ;;

    settings)
        exec quickshell ipc --path "@QS_CONFIG_DIR@/shell.qml" call settings toggle
        ;;

    wizard)
        exec quickshell ipc --path "@QS_CONFIG_DIR@/shell.qml" call wizard open
        ;;

    search)
        if [ $# -gt 0 ]; then
            exec quickshell ipc --path "@QS_CONFIG_DIR@/shell.qml" call launcher query "$*"
        fi
        exec quickshell ipc --path "@QS_CONFIG_DIR@/shell.qml" call launcher search
        ;;

    snapshot)  require_repo; exec "$REPO_ROOT/scripts/snapshot.sh" "$@" ;;

    status)
        printf 'installed:  '
        [ -e "@QS_CONFIG_DIR@" ] && echo "yes (@QS_CONFIG_DIR@)" || echo "no"
        printf 'running:    '
        pgrep -f "quickshell/@SLUG@" >/dev/null 2>&1 && echo "yes" || echo "no"
        printf 'service:    '
        systemctl --user is-active "@SYSTEMD_UNIT@" 2>/dev/null || true
        printf 'config:     %s\n' "@CONFIG_DIR@"
        printf 'state:      %s\n' "@STATE_DIR@"
        ;;

    log)     exec journalctl --user -u "@SYSTEMD_UNIT@" "$@" ;;
    start)   exec systemctl --user start "@SYSTEMD_UNIT@" ;;
    stop)    exec systemctl --user stop "@SYSTEMD_UNIT@" ;;
    restart) exec systemctl --user restart "@SYSTEMD_UNIT@" ;;

    version) echo "@DISPLAY_NAME@ @VERSION@" ;;
    help|-h|--help) usage ;;
    *) echo "unknown command: $cmd" >&2; echo >&2; usage >&2; exit 1 ;;
esac
