#!/usr/bin/env bash
# @DISPLAY_NAME@ session launcher -- rendered from bin/session.sh.in.
# GENERATED FILE -- DO NOT EDIT. Regenerate: make link  (or scripts/install.sh)
#
# Deliberately does NOT daemonize. Under a systemd user unit, detaching would
# replace journald stdio with /dev/null, and every application launched from
# the shell inherits those descriptors.
set -euo pipefail

# Quickshell resolves `import qs.<dir>` relative to the config root, so the
# shell directory itself must be on the import path.
#
# So must the place `make plugin` installs to. The window previews and the
# input module are compiled QML modules, not QML files: they land in the
# user's own Qt import directory, which Qt does not search unless it is named
# here. Built and installed but unreachable looks exactly like never built --
# the shell said "the KWinScreencast module is not installed (build it with
# `make plugin`)" while the module sat in that directory.
export QML2_IMPORT_PATH="@QS_CONFIG_DIR@:$HOME/.local/lib/qt6/qml${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}"

export QS_NO_RELOAD_POPUP=1
export QSG_RENDER_LOOP=threaded

# Safe mode loads no third-party widgets. It is the way back in when a plugin
# takes the panel down, so it is honoured before anything else runs.
if [ "${@SAFE_MODE_VAR@:-}" = "1" ]; then
    echo "@DISPLAY_NAME@: safe mode -- third-party widgets disabled" >&2
fi

# A linked install runs straight from the working tree, and a generated file
# missing from it is a login with no shell: the running one does not notice,
# having them loaded already, and the next start fails. It did five times in ten
# seconds on "Type Branding unavailable" (2026-10-08), after `make clean` took
# Branding.qml. That one and the widget index are committed now, so no clean
# removes them; this is for whatever else does -- an rm, a checkout, a script
# run from the wrong root -- and for the qmldirs, which are still gitignored.
# They are made again here, from the tree the link points into, when one is
# missing. A copied install carries its own and no tree to make them from.
if [ -L "@QS_CONFIG_DIR@" ]; then
    for generated in core/Branding.qml core/qmldir widgets/index.json; do
        [ -e "@QS_CONFIG_DIR@/$generated" ] && continue
        echo "@DISPLAY_NAME@: $generated is missing from the working tree -- generating it" >&2
        { "@REPO_ROOT@/scripts/gen-branding.sh" \
            && "@REPO_ROOT@/scripts/gen-qmldir.sh" \
            && "@REPO_ROOT@/scripts/gen-widget-index.sh"; } >/dev/null \
            || echo "@DISPLAY_NAME@: could not generate it; run \`make brand\` in @REPO_ROOT@" >&2
        break
    done
fi

exec /usr/bin/quickshell -n -p "@QS_CONFIG_DIR@/shell.qml" "$@"
