# What `@ALIAS@ theme apply` writes into KDE's own configuration, and which
# part of the desktop each line belongs to.
#
# A `# part:` marker names the setting under `theme.desktop` that governs the
# lines beneath it, so what the settings window offers and what actually gets
# written come from one declaration rather than two that can disagree. A line
# whose part is turned off is not written at all, and keeps whatever the user
# chose in System Settings. Every line that is written goes through the ledger,
# so `@ALIAS@ theme revert` puts it back either way.
#
# A `# variant:` marker names which of light and dark the lines beneath it
# belong to; `any` ends one. Only the variant being applied is written, so the
# applications follow day and night the way the shell does -- see `@ALIAS@
# theme variant`. Lines outside any variant marker are written for both.

# part: style
[kdeglobals][KDE]
widgetStyle=Breeze

# part: colours
# variant: dark
[kdeglobals][General]
ColorScheme=@DISPLAY_NAME@ Dark
# variant: light
[kdeglobals][General]
ColorScheme=@DISPLAY_NAME@ Light
# variant: any

# part: icons
# variant: dark
[kdeglobals][Icons]
Theme=breeze-dark
# variant: light
[kdeglobals][Icons]
Theme=breeze
# variant: any

# part: plasmaTheme
[plasmarc][Theme]
name=@SLUG@

# part: decorations
[kwinrc][org.kde.kdecoration2]
library=org.kde.breeze
theme=Breeze

# part: switcher
[kwinrc][TabBox]
LayoutName=@SLUG@
