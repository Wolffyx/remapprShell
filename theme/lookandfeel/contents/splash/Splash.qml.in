/*
    SPDX-License-Identifier: GPL-3.0-or-later

    The boot splash.

    Plasma drives this through `stage`, which counts up as the session comes
    together. Only the appearance is ours.

    No bundled image and no bundled font: the shell ships neither, so the
    splash is drawn from the colour scheme and the display name it already has.
    A splash that needs an asset is a splash that shows a broken one when the
    asset is missing.
*/

// The property Plasma sets on this item comes from its own loader, which the
// linter cannot see.
// qmllint disable unqualified
import QtQuick
import org.kde.kirigami as Kirigami

Rectangle {
    id: root

    // Not the colour scheme: the splash runs before anything has loaded one,
    // and a splash that flashes white while it waits is worse than one that is
    // simply dark.
    color: "#1a1c21"

    property int stage

    onStageChanged: {
        if (root.stage === 2)
            content.opacity = 1;
        else if (root.stage === 5)
            content.opacity = 0;
    }

    Column {
        id: content

        anchors.centerIn: parent
        spacing: Kirigami.Units.gridUnit * 2
        opacity: 0

        Behavior on opacity {
            NumberAnimation {
                duration: Kirigami.Units.veryLongDuration
                easing.type: Easing.InOutQuad
            }
        }

        Text {
            anchors.horizontalCenter: parent.horizontalCenter
            text: "@DISPLAY_NAME@"
            color: "#e8ebf0"
            font.pixelSize: Kirigami.Units.gridUnit * 1.5
            font.letterSpacing: 2
        }

        // A progress line rather than a spinner: it says the session is coming
        // up without pretending to know how far along it is.
        Rectangle {
            anchors.horizontalCenter: parent.horizontalCenter
            width: Kirigami.Units.gridUnit * 12
            height: 2
            radius: 1
            color: "#2a2e36"

            Rectangle {
                id: bar
                width: parent.width * 0.3
                height: parent.height
                radius: parent.radius
                color: "#7aa2f7"

                SequentialAnimation on x {
                    running: content.opacity > 0
                    loops: Animation.Infinite

                    NumberAnimation {
                        from: 0
                        to: bar.parent.width - bar.width
                        duration: Kirigami.Units.veryLongDuration * 2
                        easing.type: Easing.InOutQuad
                    }
                    NumberAnimation {
                        from: bar.parent.width - bar.width
                        to: 0
                        duration: Kirigami.Units.veryLongDuration * 2
                        easing.type: Easing.InOutQuad
                    }
                }
            }
        }
    }
}
