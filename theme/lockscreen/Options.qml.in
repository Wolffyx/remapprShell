/*
    SPDX-License-Identifier: GPL-3.0-or-later

    This lock screen's own settings.

    GENERATED FILE -- the source is Options.qml.in, rendered when the package
    is built.

    Plasma's three lock screen settings (a clock at all, a clock while idle,
    media controls) reach the greeter as its `config` object. **Ours cannot**:
    measured on Plasma 6.7.5, the greeter builds that object from the *desktop*
    package's `lockscreen/config.xml`, not from the package it is drawing, so a
    key added to ours never appears. So this shell's own settings live in a
    small file of their own, read here and written by `rmpr lockscreen set`.

    A file rather than something baked into the installed copy, because the
    installed copy is the one `try` unlocked: changing a setting must not
    change the build, or every change would have to be tried again.
*/
pragma Singleton

import QtCore
import QtQuick

QtObject {
    id: root

    readonly property Settings file: Settings {
        id: settings
        category: "Lock"
        // KConfig's own format, so `rmpr lockscreen set` can write it with
        // kwriteconfig6 and a person can read it. `location` rather than the
        // `fileName` Qt.labs.settings had: QtCore's Settings takes a url.
        location: "file://@CONFIG_DIR@/lockscreen.conf"
    }

    // Which lock screen is drawn. LockUi knows the names; an unknown one
    // falls back to glass there rather than to an empty screen here.
    readonly property string style: settings.value("style", "glass")

    readonly property string clockPosition: settings.value("clockPosition", "left")
    readonly property int wallpaperBlur: Math.max(0, Math.min(40, Number(settings.value("wallpaperBlur", 26))))
    readonly property bool showSessionButtons: String(settings.value("showSessionButtons", "true")) !== "false"

    // The one colour every style draws its focus and its primary button in.
    // Four, by name, as the design offers them -- a name rather than a hex
    // string so that a typo is the default rather than an invisible focus
    // ring.
    readonly property var accents: ({
        "indigo": "#4f60c8",
        "terracotta": "#c8674f",
        "green": "#3f8f6e",
        "violet": "#8a5cc8",
    })
    readonly property color accent: root.accents[String(settings.value("accent", "indigo"))] ?? root.accents.indigo

    // Seconds without a key or the pointer before the screen dims to the
    // clock alone. Zero never dims: Plasma turns the screen off on its own
    // schedule regardless, and some people want only that.
    readonly property int dimSeconds: Math.max(0, Math.min(600, Number(settings.value("dimSeconds", 20)) || 0))

    // The shutter lifting after a correct password. Off, the greeter quits
    // the moment it is let in, as Plasma's does.
    readonly property bool unlockAnimation: String(settings.value("unlockAnimation", "true")) !== "false"

    // The charge, in percent, at which the lock screen hibernates on its own
    // after a minute's warning. Zero never does, and leaves it to Plasma's
    // power management -- which has a critical-battery action of its own.
    readonly property int hibernateAt: Math.max(0, Math.min(10, Number(settings.value("hibernateAt", 3)) || 0))

    // The kiosk style's two lines of text: whose computer this is, and the
    // one thing a guest should know. Empty draws a generic name and nothing.
    readonly property string kioskName: String(settings.value("kioskName", ""))
    readonly property string kioskNote: String(settings.value("kioskNote", ""))
}
