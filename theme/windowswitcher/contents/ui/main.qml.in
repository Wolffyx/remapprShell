/*
    SPDX-License-Identifier: GPL-3.0-or-later

    Alt+Tab, drawn as the Meridian design draws it.

    KWin draws this; only its appearance is ours. `TabBoxSwitcher` is the
    interface KWin drives -- it sets `model` and `currentIndex` and reads back
    `currentIndex` when the switcher chooses -- so those names are exactly as
    KWin expects and everything else is presentation.

    What KWin offers a layout is `caption`, `icon`, `minimized`, `windowId` --
    and `KWin.WindowThumbnail`, which draws the window itself. Inside KWin a
    preview costs nothing; it is the one place that is true. Everywhere else in
    this project a preview means speaking the screencast protocol in C++ and
    feeding PipeWire, which is what plugin/ exists for.

    An earlier note here said there were no previews in this file. That was
    true when it was written and has not been since; it is corrected rather
    than deleted because "KWin will not give us one" was believed for four
    days and is worth being explicit about.

    Colours come from the active colour scheme through Kirigami.Theme, which is
    the whole point of shipping one: this matches the panel without either
    knowing about the other.

    The header and the footer are files of their own beside this one,
    SwitcherHeader.qml and SwitcherFooter.qml. KWin loads this file by its
    path, and QML finds a type in the same directory by its file name, so
    the package needs no qmldir. It holds no qs.* imports either, for the
    same reason as this file: it runs inside kwin_wayland, not the shell.
    The card stays here, because it is the one that draws with KWin's own
    types -- a second file importing org.kde.kwin is a second import the
    linter cannot resolve.
*/

// The base type lives in KWin's own qrc and cannot be resolved by the linter,
// so its properties would otherwise all read as unqualified access.
// qmllint disable unqualified
import QtQuick
import org.kde.plasma.core as PlasmaCore
import org.kde.plasma.components as PlasmaComponents3
import org.kde.kirigami as Kirigami
import org.kde.kwin as KWin

KWin.TabBoxSwitcher {
    id: tabBox

    currentIndex: tabBox.grid ? gridCards.currentIndex : cards.currentIndex

    // Which of the design's three layouts this package is.
    //
    // Three packages are installed from these same files -- row, grid and
    // icons -- because KWin picks a switcher by package and a layout running
    // inside kwin_wayland cannot read this shell's configuration. Choosing one
    // is therefore choosing a switcher, which is what `rmpr switcher layout`
    // and the settings page already do.
    readonly property string layout: "@SWITCHER_LAYOUT@"
    readonly property bool grid: tabBox.layout === "grid"
    readonly property bool icons: tabBox.layout === "icons"

    // The design's row: a card 196 wide with a 118-tall panel above its name.
    // The grid's cards are wider and their panels taller, since the point of
    // wrapping is to give each one more room; the icons layout drops the panel
    // and is the application's icon and name alone.
    readonly property int cardWidth: tabBox.grid ? 250 : tabBox.icons ? 104 : 196
    readonly property int panelHeight: tabBox.grid ? 150 : 118
    readonly property bool showPanel: !tabBox.icons

    // Four cards to a row before it wraps, which is where the design puts it.
    readonly property int gridColumns: 4
    readonly property int cardHeight: tabBox.showPanel ? tabBox.panelHeight + 78 : 128
    readonly property int gap: 14
    readonly property int pad: 26
    readonly property int radius: 18

    readonly property color accent: Kirigami.Theme.highlightColor
    readonly property color ink: Kirigami.Theme.textColor
    readonly property color inkMuted: Kirigami.Theme.disabledTextColor
    readonly property color surface: Kirigami.Theme.backgroundColor
    readonly property color outline: Qt.rgba(tabBox.ink.r, tabBox.ink.g, tabBox.ink.b, 0.12)

    // Moving and choosing, in one place: the delegate and the arrow keys both
    // go through these rather than reaching into whichever view is drawn.
    function select(index) {
        cards.currentIndex = index;
        gridCards.currentIndex = index;
    }

    function step(delta) {
        const n = cards.count;
        if (n === 0)
            return;
        tabBox.select(((tabBox.currentIndex + delta) % n + n) % n);
    }

    // A colour for a card's panel, hashed from the window's caption: of what
    // a layout is given, the one string that says anything about the window.
    // Two windows with one title share a colour -- and two windows of one
    // program with different titles do not.
    function tintFor(text) {
        let h = 0;
        const s = String(text ?? "");
        for (let i = 0; i < s.length; i++)
            h = (h * 31 + s.charCodeAt(i)) % 360;
        return Qt.hsla(h / 360, 0.34, Kirigami.Theme.backgroundColor.hslLightness > 0.5 ? 0.62 : 0.38, 1);
    }

    PlasmaCore.Dialog {
        id: dialog

        location: PlasmaCore.Types.Floating
        visible: tabBox.visible
        flags: Qt.Popup | Qt.X11BypassWindowManagerHint

        x: tabBox.screenGeometry.x + (tabBox.screenGeometry.width - dialog.width) / 2
        y: tabBox.screenGeometry.y + (tabBox.screenGeometry.height - dialog.height) / 2

        mainItem: Item {
            id: content

            // Never wider than most of the screen: with thirty windows open
            // the row scrolls rather than running off both edges.
            readonly property int maxWidth: tabBox.screenGeometry.width * 0.86

            // `contentWidth` is the row as laid out -- the cards plus their
            // spacing. It was `implicitContentWidth`, which no ListView has:
            // the sum came out NaN, the dialog had no width to be given, and
            // KWin's switcher drew nothing at all on every machine this
            // package was selected on. qmllint said so from the start
            // ("Did you mean implicitWidth?") and it was read as noise about
            // KWin's own unresolvable types.
            readonly property int gridInRow: Math.min(tabBox.gridColumns, Math.max(1, cards.count))
            readonly property real cardsWidth: tabBox.grid
                ? content.gridInRow * (tabBox.cardWidth + tabBox.gap)
                : cards.contentWidth
            readonly property real cardsHeight: tabBox.grid ? gridCards.height : cards.height

            implicitWidth: Math.min(content.maxWidth, content.cardsWidth + 2 * tabBox.pad)
            implicitHeight: header.height + content.cardsHeight + footer.height + 3 * tabBox.pad / 2

            // ---- header: what this is, and that Alt is still held ----------
            SwitcherHeader {
                id: header

                anchors.top: parent.top
                anchors.left: parent.left
                anchors.right: parent.right
                anchors.margins: tabBox.pad / 2

                count: cards.count
                accent: tabBox.accent
                ink: tabBox.ink
                outline: tabBox.outline
            }

            // ---- the cards -------------------------------------------------
            //
            // Two views, one delegate: a horizontal list for the row and the
            // icons, a grid for the layout that wraps. Only one of them is
            // ever in use, and `currentIndex` above follows whichever it is.
            ListView {
                id: cards

                visible: !tabBox.grid

                anchors.top: header.bottom
                anchors.left: parent.left
                anchors.right: parent.right
                anchors.topMargin: tabBox.pad / 2
                anchors.leftMargin: tabBox.pad / 2
                anchors.rightMargin: tabBox.pad / 2

                height: tabBox.cardHeight
                orientation: ListView.Horizontal
                spacing: tabBox.gap
                clip: true
                focus: true
                boundsBehavior: Flickable.StopAtBounds
                highlightRangeMode: ListView.ApplyRange
                preferredHighlightBegin: width / 2 - tabBox.cardWidth
                preferredHighlightEnd: width / 2 + tabBox.cardWidth
                highlightMoveDuration: Kirigami.Units.shortDuration

                model: tabBox.model
                delegate: cardDelegate
            }

            GridView {
                id: gridCards

                visible: tabBox.grid
                anchors.top: header.bottom
                anchors.left: parent.left
                anchors.right: parent.right
                anchors.topMargin: tabBox.pad / 2
                anchors.leftMargin: tabBox.pad / 2
                anchors.rightMargin: tabBox.pad / 2

                // As many rows as it takes, up to four; past that it scrolls
                // rather than growing past the screen.
                height: Math.min(4, Math.ceil(gridCards.count / tabBox.gridColumns))
                        * (tabBox.cardHeight + tabBox.gap)
                cellWidth: tabBox.cardWidth + tabBox.gap
                cellHeight: tabBox.cardHeight + tabBox.gap
                clip: true
                focus: true
                boundsBehavior: Flickable.StopAtBounds

                model: tabBox.model
                delegate: cardDelegate
            }

            Component {
                id: cardDelegate

                Item {
                    id: entry

                    required property int index
                    required property string caption
                    required property var icon
                    required property bool minimized
                    required property var windowId

                    readonly property bool selected: entry.index === tabBox.currentIndex

                    width: tabBox.cardWidth
                    height: tabBox.cardHeight

                    Rectangle {
                        id: card

                        // The selected card lifts. Through a property of its
                        // own: a Behavior cannot be attached to a member of a
                        // grouped property, and `Behavior on anchors.topMargin`
                        // is a load-time error that takes the whole switcher
                        // with it -- which looks exactly like Alt+Tab doing
                        // nothing at all.
                        property real lift: entry.selected ? 0 : 4
                        Behavior on lift { NumberAnimation { duration: Kirigami.Units.shortDuration } }

                        anchors.fill: parent
                        anchors.topMargin: card.lift
                        radius: tabBox.radius
                        color: entry.selected
                               ? Qt.rgba(tabBox.accent.r, tabBox.accent.g, tabBox.accent.b, 0.18)
                               : Qt.rgba(tabBox.ink.r, tabBox.ink.g, tabBox.ink.b, 0.05)
                        border.width: entry.selected ? 2 : 1
                        border.color: entry.selected ? tabBox.accent : tabBox.outline
                        opacity: entry.minimized && !entry.selected ? 0.65 : 1

                        // The tinted panel, with the window's own icon over it
                        // at a size that reads as artwork rather than a badge.
                        Rectangle {
                            id: panel

                            anchors.top: parent.top
                            anchors.left: parent.left
                            anchors.right: parent.right
                            anchors.margins: 10
                            height: tabBox.panelHeight
                            radius: 12
                            clip: true
                            color: tabBox.tintFor(entry.caption)

                            // The icon, large and faint, behind whatever the
                            // preview turns out to be: a window KWin has no
                            // picture of still reads as that application.
                            Kirigami.Icon {
                                anchors.right: parent.right
                                anchors.bottom: parent.bottom
                                anchors.rightMargin: -12
                                anchors.bottomMargin: -18
                                width: 96; height: 96
                                source: entry.icon
                                opacity: 0.38
                            }

                            // The window itself. KWin renders this for its own
                            // switcher, which is the one place a preview costs
                            // nothing: an ordinary client cannot get one
                            // without speaking the screencast protocol in C++
                            // and feeding PipeWire, which is what every other
                            // shell that shows previews is doing.
                            KWin.WindowThumbnail {
                                anchors.fill: parent
                                anchors.topMargin: 22
                                wId: entry.windowId
                                opacity: entry.minimized ? 0.55 : 1
                            }

                            // The design's little title strip along the top.
                            Rectangle {
                                anchors.top: parent.top
                                anchors.left: parent.left
                                anchors.right: parent.right
                                height: 22
                                color: Qt.rgba(tabBox.surface.r, tabBox.surface.g, tabBox.surface.b, 0.82)

                                Row {
                                    anchors.fill: parent
                                    anchors.leftMargin: 8
                                    anchors.rightMargin: 8
                                    spacing: 5

                                    Kirigami.Icon {
                                        anchors.verticalCenter: parent.verticalCenter
                                        width: 11; height: 11
                                        source: entry.icon
                                    }
                                    PlasmaComponents3.Label {
                                        anchors.verticalCenter: parent.verticalCenter
                                        width: parent.width - 24
                                        text: entry.caption
                                        textFormat: Text.PlainText
                                        elide: Text.ElideRight
                                        font.pointSize: Kirigami.Theme.smallFont.pointSize - 1
                                        color: tabBox.inkMuted
                                    }
                                }
                            }
                        }

                        // The name under it, with the icon in a chip.
                        Row {
                            anchors.top: panel.bottom
                            anchors.left: parent.left
                            anchors.right: parent.right
                            anchors.margins: 10
                            anchors.topMargin: 11
                            spacing: 10

                            Rectangle {
                                width: 36; height: 36; radius: 12
                                color: entry.selected ? tabBox.accent
                                                      : Qt.rgba(tabBox.ink.r, tabBox.ink.g, tabBox.ink.b, 0.07)

                                Kirigami.Icon {
                                    anchors.centerIn: parent
                                    width: 20; height: 20
                                    source: entry.icon
                                }
                            }

                            Column {
                                width: parent.width - 46
                                anchors.verticalCenter: parent.verticalCenter
                                spacing: 2

                                PlasmaComponents3.Label {
                                    width: parent.width
                                    text: entry.caption
                                    textFormat: Text.PlainText
                                    elide: Text.ElideRight
                                    font.weight: Font.Medium
                                    color: tabBox.ink
                                }
                                PlasmaComponents3.Label {
                                    width: parent.width
                                    text: entry.minimized ? "Minimised" : "Open"
                                    textFormat: Text.PlainText
                                    elide: Text.ElideRight
                                    font.pointSize: Kirigami.Theme.smallFont.pointSize
                                    color: tabBox.inkMuted
                                }
                            }
                        }
                    }

                    TapHandler {
                        onTapped: {
                            tabBox.select(entry.index);
                            tabBox.model.activate(entry.index);
                        }
                    }
                }

            }

            // KWin moves the selection by setting `currentIndex` on the
            // switcher; the view in use has to follow it. Both are set, since
            // the other one is not drawn and does not care.
            Connections {
                target: tabBox
                function onCurrentIndexChanged(): void {
                    cards.currentIndex = tabBox.currentIndex;
                    gridCards.currentIndex = tabBox.currentIndex;
                }
            }

            // ---- footer: the selected window, and the keys ------------------
            SwitcherFooter {
                id: footer

                anchors.top: tabBox.grid ? gridCards.bottom : cards.bottom
                anchors.left: parent.left
                anchors.right: parent.right
                anchors.margins: tabBox.pad / 2
                anchors.topMargin: 14

                caption: (tabBox.grid ? gridCards.currentItem?.caption : cards.currentItem?.caption)
                         ?? "No open windows"
                ink: tabBox.ink
                inkMuted: tabBox.inkMuted
                outline: tabBox.outline
            }

            PlasmaComponents3.Label {
                anchors.centerIn: parent
                visible: cards.count === 0
                textFormat: Text.PlainText
                opacity: 0.7
                text: "No open windows"
            }

            // Key handling belongs on the outer item: on the list view it is
            // lost between invocations, which shows up as Alt+Tab working the
            // first time and not the second.
            Keys.onPressed: event => {
                if (event.key === Qt.Key_Left || event.key === Qt.Key_Up) {
                    tabBox.step(-1);
                    event.accepted = true;
                } else if (event.key === Qt.Key_Right || event.key === Qt.Key_Down) {
                    tabBox.step(1);
                    event.accepted = true;
                }
            }
        }
    }
}
